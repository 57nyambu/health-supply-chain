# AfyaSync environment — copy to .env (make setup does this) and adjust.
# Dev-safe defaults only. Never commit .env. Every variable is described in
# docs/operations/ENV.md; add new ones there and here in the same commit.

# --- Django ---------------------------------------------------------------
# dev | test | prod — selects api/config/settings/<env>.py
DJANGO_ENV=dev
# Production: a random value of at least 50 characters (prod refuses defaults).
DJANGO_SECRET_KEY=
# Ignored in prod (always off there).
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins allowed to POST with CSRF, e.g. https://hmis.example.ke
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://127.0.0.1:3100
LOG_LEVEL=INFO
# Sentry-compatible DSN; off when empty or when its host fails the residency guard.
ERROR_TRACKER_DSN=

# --- Database and broker --------------------------------------------------
DATABASE_URL=postgres://afyasync:afyasync@127.0.0.1:5432/afyasync
DB_CONN_MAX_AGE=60
REDIS_URL=redis://127.0.0.1:6379/0

# --- Data protection --------------------------------------------------------
# Local object store root; defaults to <repo>/data. Real patient files in production.
DATA_DIR=
# JSON {"<key id>": "<base64 32-byte key>"}, newest first. Required in prod.
FIELD_ENCRYPTION_KEYS=
# Separate key for HMAC blind indexes (exact-match search). Required in prod.
FIELD_BLIND_INDEX_KEY=
# JSON {"<key id>": "<base64 32-byte key>"} wrapping document data keys. Required in prod.
STORAGE_MASTER_KEYS=
# Where new documents go: local (DATA_DIR/objects, the default) or s3 (docs/integrations/STORAGE.md)
STORAGE_BACKEND=local
# S3-compatible bucket (MinIO in dev, Kenya-hosted endpoint in production; see residency guard)
S3_ENDPOINT_URL=
S3_REGION_NAME=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# path-style addressing is the safe default for non-AWS S3
S3_ADDRESSING_STYLE=path
S3_SIGNATURE_VERSION=s3v4
# Envelope encryption of every stored object; production refuses off
STORAGE_ENCRYPTION=on
# Upload limit in bytes (25 MB) and allowed types (checked by magic bytes)
DOCUMENT_MAX_BYTES=26214400
DOCUMENT_ALLOWED_TYPES=application/pdf,image/jpeg,image/png,image/webp
# strict | warn | off (prod default strict; off is refused in prod)
DATA_RESIDENCY_MODE=warn
# Hosts allowed to receive PHI (S3 endpoint, backup target, error tracker, log shipper)
RESIDENCY_ALLOWED_HOSTS=
# Password given to synthetic seed users by `make seed` (dev/CI only).
SEED_PASSWORD=
# Development only: seeded users without an authenticator skip MFA (refused in production)
MFA_DEV_BYPASS=False
# Take the client IP from X-Real-IP set by nginx (prod default True).
TRUST_PROXY_HEADERS=False
# Production DB role used by the API; migrations revoke UPDATE/DELETE on audit tables from it.
DB_APP_ROLE=
# Legacy AI endpoints stay off until a DPIA covers them (ADR-014).
AI_FEATURES_ENABLED=False

# --- Production transport security (prod only) ------------------------------
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# --- Email and notifications ------------------------------------------------
NOTIFICATION_CHANNEL=email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=alerts@afyasync.local
# Seconds before an SMTP attempt gives up; unsent notices are retried every minute for 48 h.
EMAIL_TIMEOUT=10
SITE_NAME=AfyaSync

# --- Authentication ---------------------------------------------------------
# Optional larger offline breached-password list (one per line, may be .gz).
BREACHED_PASSWORDS_FILE=
# Comma-separated CIDRs of the facility LAN; sign-ins from other networks need MFA.
FACILITY_NETWORK_ALLOWLIST=127.0.0.0/8,::1/128
# Health Worker Registry lookups: fake | sandbox | live (only fake until P3-SHA-01).
HWR_MODE=fake
# HIE Client Registry lookups at reception: fake until P3-SHA-01 (GAP-CR-001)
CLIENT_REGISTRY_MODE=fake
# Login attempts per client IP.
LOGIN_RATE=20/min
# Patient searches per user (search is audited; DESIGN api/CLAUDE.md).
PATIENT_SEARCH_RATE=60/min
# Workstation PIN attempts (unlock/switch) per client IP.
PIN_RATE=10/min

# --- Legacy integrations (replaced by adapters in later phases) --------------
GEMMA_API_KEY=
GEMMA_MODEL_ASSISTANT=gemma-4-4b-it
GEMMA_MODEL_VISION=gemma-4-12b-it
GEMMA_CACHE_TTL_SECONDS=1200
# Rate limit per API client on the public, non-PHI API (create clients with manage.py create_api_client).
PUBLIC_API_RATE=120/min
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_BUSINESS_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
AT_USERNAME=
AT_API_KEY=

# --- Phase 2 lane (ADR-024): settings added by the Phase 2 lane only -------------------------

# --- Phase 3 lane (ADR-024): settings added by the Phase 3 lane only -------------------------
