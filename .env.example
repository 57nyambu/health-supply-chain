# Django core
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,afyasyc.dima.co.ke

# Database and worker infra
DATABASE_URL=sqlite:///db.sqlite3
REDIS_URL=redis://localhost:6379/0

# CORS and JWT
CORS_ALLOWED_ORIGINS=http://localhost:5500,https://afyasyc.dima.co.ke
JWT_ACCESS_LIFETIME_MIN=15
JWT_REFRESH_LIFETIME_DAYS=7

# Gemma
GEMMA_API_KEY=
GEMMA_MODEL_ASSISTANT=gemma-4-4b-it
GEMMA_MODEL_VISION=gemma-4-12b-it
GEMMA_CACHE_TTL_SECONDS=1200

# Public API
PUBLIC_API_KEY=

# Notification channel (email for this build)
NOTIFICATION_CHANNEL=email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=alerts@afyasyc.dima.co.ke

# Existing integrations (optional for this track)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_BUSINESS_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
AT_USERNAME=
AT_API_KEY=
SITE_NAME=AfyaSync
