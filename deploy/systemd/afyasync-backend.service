[Unit]
Description=AfyaSync Django Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tom
Group=tom
WorkingDirectory=/home/afya-back
EnvironmentFile=-/home/afya-back/.env
Environment=DJANGO_SETTINGS_MODULE=root.settings.production
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/afya-back/venv/bin/gunicorn root.wsgi:application --bind 127.0.0.1:8000 --workers 3 --timeout 120
Restart=on-failure
RestartSec=5
UMask=0027
PrivateTmp=true
NoNewPrivileges=true
KillSignal=SIGQUIT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
